Table interview_panel_users {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  first_name varchar
  last_name varchar
  email varchar
  mobile_no varchar
  department uuid [ref: > departments.id]
  designation uuid [ref: > designations.id]
  gender varchar [note: 'male | female | other']
  status varchar [default: 'active']
  password varchar
  token text
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table offer_letters {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  firstName varchar
  lastName varchar
  fatherName varchar
  gender varchar [note: 'Male | Female | Other']
  dob date
  aadhaarNo varchar
  mobileNo varchar
  email varchar
  permanentAddress text
  designation varchar
  department varchar
  headOffice varchar
  joiningDate date
  offerDate date
  refNo varchar
  pdfUrl text
  pdfFileName varchar
  pdfGeneratedAt timestamp
  createdBy uuid shiv sir
  createdAt timestamp
  updatedAt timestamp
}

Table skills {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  name varchar
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

// ─────────────────────────────────────────────
// PREFIXES / MISC SETTINGS
// ─────────────────────────────────────────────

Table prefixes {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  name varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

// ─────────────────────────────────────────────
// AUDIT / AUTH
// ─────────────────────────────────────────────

Table logs {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  actionType varchar
  referenceId uuid
  oldValue json
  newValue json
  remarks varchar
  ipAddress varchar
  createdBy uuid
  createdAt timestamp
  updatedAt timestamp
  deletedAt timestamp [note: 'soft delete']
}

Table otps {
  id uuid [pk]
  deviceId varchar
  type varchar
  otp bigint
  expiry_time varchar
  phone varchar
  ip varchar
  created_by uuid
  status boolean [default: true]
}

// ─────────────────────────────────────────────
// REFERENCE / GEO DATA
// ─────────────────────────────────────────────

Table countries {
  id integer [pk, increment]
  shortname varchar [unique]
  name varchar
  phonecode integer
  branchId uuid
}

Table states {
  id integer [pk, increment]
  name varchar
  country_id integer [ref: > countries.id]
  branchId uuid
}

Table cities {
  id integer [pk, increment]
  name varchar
  state_id integer [ref: > states.id]
  branchId uuid
}

Table pin_code_master {
  id varchar [pk]
  office_name varchar
  pin_code bigint
  division_name varchar
  circle_name varchar
  taluka varchar
  district_name varchar
  state_name varchar
}

// ─────────────────────────────────────────────
// LANDING PAGE
// ─────────────────────────────────────────────

Table landing_contact_submissions {
  id uuid [pk]
  fullName varchar
  email varchar
  message text
  ipAddress varchar
  userAgent varchar
  createdAt timestamp
  updatedAt timestamp
}

Table landing_site_contents {
  id uuid [pk]
  slug varchar [unique, default: 'default']
  payload jsonb [default: '{}']
  createdAt timestamp
  updatedAt timestamp
}

TableGroup superadmin_model {
  tenants
  subscriptions
  plan_masters
  platform_modules
  tenant_module_access
  users
  branches
  landing_contact_submissions
  landing_site_contents
  logs
  otps
}

TableGroup attendance_employee_management_model {
  departments
  designations
  employment_types
  shifts
  emp_personals
  work_experiences
  documents
  document_types
  bank_accounts
  letter_datas
  attendances
  attendance_settings
  attendance_regularizations
  comp_offs
  device_location_logs
  leave_masters
  leave_applications
  leave_balances
  holidays
  holiday_types
  master_components
  basics
  allowances
  deductions
  bills
  bill_infos
  salary_docs
  salary_orders
  currencies
  reimbursements
  reimbursement_files
}

TableGroup recruitment_tracking_model {
  candidates
  job_requirements
  applications
  candidate_ats_scores
  round_types
  interview_rounds
  candidate_interview_rounds
  candidate_interview_feedback
  interview_panel_users
  offer_letters
  skills
  tracking_sessions
  tracking_points
  tracking_task_updates
}
