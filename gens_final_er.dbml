// GENS HR Management System - Entity Relationship Diagram
// Generated from Sequelize models

Project GENS {
  database_type: 'PostgreSQL'
  Note: 'Multi-tenant HR, Payroll, Attendance, Leave, ATS platform'
}

// ─────────────────────────────────────────────
// CORE / TENANT
// ─────────────────────────────────────────────

Table tenants {
  id uuid [pk]
  companyName varchar
  companyAddress text
  image varchar
  companyCode varchar [unique]
  status varchar [default: 'active', note: 'active | inactive']
  plan varchar [default: 'basic']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table subscriptions {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  plan varchar
  status varchar [default: 'active', note: 'active | expired | cancelled']
  startsAt timestamp
  endsAt timestamp
  seats integer
  notes text
  metadata jsonb
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table plan_masters {
  id uuid [pk]
  name varchar [unique]
  code varchar [unique]
  price decimal
  billingCycle varchar [note: 'monthly | yearly | one_time']
  durationDays integer
  maxUsers integer
  description text
  status varchar [default: 'active']
  metadata jsonb
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table platform_modules {
  id uuid [pk]
  name varchar
  code varchar [unique, note: 'superadmin | attendance_employee_management | recruitment_tracking']
  description text
  displayOrder integer
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table tenant_module_access {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  moduleId uuid [ref: > platform_modules.id]
  planId uuid [ref: > plan_masters.id]
  isEnabled boolean [default: true]
  startsAt timestamp
  endsAt timestamp
  settings jsonb [default: '{}']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp

  indexes {
    (tenantId, moduleId) [unique]
  }
}

Table users {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  name varchar
  email varchar [unique]
  password varchar
  role varchar [note: 'admin | hr | employee | superadmin']
  status varchar [default: 'active']
  token text
  webcamtoken text
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table branches {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  name varchar
  description text
  latitude decimal
  longitude decimal
  image varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

// ─────────────────────────────────────────────
// ORGANISATION STRUCTURE
// ─────────────────────────────────────────────

Table departments {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  name varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table designations {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  department uuid [ref: > departments.id]
  name varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table employment_types {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  name varchar
  duration_type varchar [note: 'full_paid | half_paid']
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table shifts {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  shift varchar [note: 'Day | Night | Afternoon | General']
  day_of_week varchar [note: 'Monday–Sunday']
  startTime time
  endTime time
  workingHours decimal
  is_week_off boolean [default: false]
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

// ─────────────────────────────────────────────
// EMPLOYEE
// ─────────────────────────────────────────────

Table emp_personals {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  firstName varchar
  lastName varchar
  email varchar [unique]
  mobile varchar
  alternateMobile varchar
  permanentAddress varchar
  currentAddress varchar
  dateOfBirth date
  age integer
  gender varchar [note: 'Male | Female | Other']
  martialStatus varchar [note: 'Single | Married | Divorced | Separated | Widowed']
  adhaarNo varchar
  panNo varchar
  fatherName varchar
  motherName varchar
  guarantorName varchar
  bloodGroup varchar [note: 'A+ | A- | B+ | B- | AB+ | AB- | O+ | O-']
  nationality varchar
  pinCode varchar
  state varchar
  city varchar
  country varchar
  role varchar
  emp_status varchar [default: 'pending']
  status varchar [default: 'active']
  joiningDate date
  exitDate date
  empCode varchar
  shift_id varchar
  designationId uuid [ref: > designations.id]
  departmentId uuid [ref: > departments.id]
  empType uuid [ref: > employment_types.id]
  reportingPersonId uuid [ref: > emp_personals.id]
  profileImage varchar
  token text
  deviceId varchar
  deviceToken text
  isLocation boolean [default: false]
  isofflineAtt boolean [default: false]
  isofflineAllTimeAtt boolean [default: false]
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table work_experiences {
