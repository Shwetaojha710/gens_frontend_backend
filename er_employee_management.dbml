// GENS HR Management System — Employee Management Module
// Covers: org structure, employees, attendance, leave, payroll, reimbursements

Project GENS_EmployeeManagement {
  database_type: 'PostgreSQL'
  Note: 'Employee Management module — org structure, attendance, leave, payroll, reimbursements'
}

// ─────────────────────────────────────────────
// SHARED REFERENCES (owned by Super Admin)
// ─────────────────────────────────────────────

Table tenants {
  id uuid [pk]
  companyName varchar
  companyCode varchar [unique]
  status varchar [default: 'active']
  createdAt timestamp
  updatedAt timestamp

  Note: 'Shared — owned by Super Admin module'
}

Table branches {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  name varchar
  status varchar [default: 'active']
  createdAt timestamp
  updatedAt timestamp

  Note: 'Shared — owned by Super Admin module'
}

// ─────────────────────────────────────────────
// ORGANISATION STRUCTURE
// ─────────────────────────────────────────────

Table departments {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  name varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table designations {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  department uuid [ref: > departments.id]
  name varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table employment_types {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  name varchar
  duration_type varchar [note: 'full_paid | half_paid']
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table shifts {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  shift varchar [note: 'Day | Night | Afternoon | General']
  day_of_week varchar [note: 'Monday–Sunday']
  startTime time
  endTime time
  workingHours decimal
  is_week_off boolean [default: false]
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table prefixes {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  name varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

// ─────────────────────────────────────────────
// EMPLOYEE PROFILE
// ─────────────────────────────────────────────

Table emp_personals {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  firstName varchar
  lastName varchar
  email varchar [unique]
  mobile varchar
  alternateMobile varchar
  permanentAddress varchar
  currentAddress varchar
  dateOfBirth date
  age integer
  gender varchar [note: 'Male | Female | Other']
  martialStatus varchar [note: 'Single | Married | Divorced | Separated | Widowed']
  adhaarNo varchar
  panNo varchar
  fatherName varchar
  motherName varchar
  guarantorName varchar
  bloodGroup varchar [note: 'A+ | A- | B+ | B- | AB+ | AB- | O+ | O-']
  nationality varchar
  pinCode varchar
  state varchar
  city varchar
  country varchar
  role varchar
  emp_status varchar [default: 'pending']
  status varchar [default: 'active']
  joiningDate date
  exitDate date
  empCode varchar
  shift_id varchar
  designationId uuid [ref: > designations.id]
  departmentId uuid [ref: > departments.id]
  empType uuid [ref: > employment_types.id]
  reportingPersonId uuid [ref: > emp_personals.id]
  profileImage varchar
  token text
  deviceId varchar
  deviceToken text
  isLocation boolean [default: false]
  isofflineAtt boolean [default: false]
  isofflineAllTimeAtt boolean [default: false]
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table work_experiences {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  companyName varchar
  designation varchar
  description text
  from date
  to date
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table document_types {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  type varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table documents {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  type varchar
  doc_type varchar
  doc_name varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table bank_accounts {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  accountHolderName varchar
  bankName varchar
  bankBranch varchar
  accountNumber varchar
  ifscCode varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table letter_datas {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  type varchar [note: 'nda | appointment | relieving | offer']
  data json
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

// ─────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────

Table attendances {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  date date
  month integer
  year integer
  check_in_time varchar
  check_out_time varchar
  Inlatitude varchar
  Inlongitude varchar
  Outlatitude varchar
  Outlongitude varchar
  check_in_img varchar
  check_out_img varchar
  ip_address varchar
  is_present boolean [default: false]
  is_comp_off_approve boolean [default: false]
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table attendance_settings {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  lateAllowanceMin integer [default: 3]
  graceMinutes integer [default: 15]
  halfDayThreshold integer [default: 45]
  halfdayToAbsentMin integer [default: 4]
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table attendance_regularizations {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  attendanceDate date
  inTimeRequested varchar
  outTimeRequested varchar
  reason text
  status varchar [default: 'pending', note: 'pending | approved | rejected']
  approverId uuid [ref: > emp_personals.id]
  approvedAt timestamp
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table comp_offs {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  attendanceId uuid [ref: > attendances.id]
  earnedDate date
  expiryDate date
  totalDays decimal
  usedDays decimal [default: 0]
  remainingDays decimal [default: 1]
  status varchar [default: 'active', note: 'active | expired | used']
  approval_status varchar [default: 'approved']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table device_location_logs {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  device_id varchar
  device_os varchar [note: 'A | I | W']
  latitude double
  longitude double
  altitude double
  accuracy double
  heading double
  speed double
  mode varchar [note: 'foreground | background']
  network_mode varchar
  tracked_at timestamp
  address varchar
  visit_place varchar
  purpose varchar
  remark varchar
  feedback varchar
  location_type varchar [default: 'normal']
  createdAt timestamp
  updatedAt timestamp
}

// ─────────────────────────────────────────────
// LEAVE
// ─────────────────────────────────────────────

Table leave_masters {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  leaveName varchar
  leaveCode varchar
  isPaid boolean [default: true]
  allowedPerYear integer
  carryForward boolean
  maxCarryForward integer [default: 0]
  enCashable boolean [default: false]
  genderRestriction varchar [note: 'male | female | all']
  requiresApproval boolean [default: true]
  applyBeforeDays integer [default: 0]
  description text
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table leave_applications {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  leaveTypeId uuid [ref: > leave_masters.id]
  compOffId uuid [ref: > comp_offs.id]
  fromDate date
  toDate date
  duration_type varchar [note: 'full | first_half | second_half | short_leave']
  to_duration_type varchar [note: 'full | first_half | second_half | short_leave']
  days decimal
  reason text
  status varchar [default: 'pending', note: 'pending | recommended | approved | rejected | escalate | self_declined']
  approverId uuid [ref: > emp_personals.id]
  recommendedId uuid [ref: > emp_personals.id]
  canceledId uuid [ref: > emp_personals.id]
  appliedOn date
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table leave_balances {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  leaveTypeId uuid [ref: > leave_masters.id]
  year integer
  month integer
  totalAssigned decimal
  usedLeaves decimal [default: 0]
  carryForwarded decimal [default: 0]
  remainingLeaves decimal [default: 0]
  prevremainingLeaves decimal
  prevusedLeaves decimal [default: 0]
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table holidays {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  holiday_name varchar
  date date
  holiday_type varchar
  image varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table holiday_types {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  name varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

// ─────────────────────────────────────────────
// PAYROLL / SALARY
// ─────────────────────────────────────────────

Table master_components {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  component_name varchar
  value decimal
  value_type varchar [note: 'fixed | percentage | basic_dependent | is_special']
  amount decimal
  dependent_component jsonb
  component_description text
  component_type varchar [note: 'payable | deductible | reimbursable']
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table basics {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  componentId uuid [ref: > master_components.id]
  name varchar
  type varchar
  dependent varchar
  amount decimal
  typeValue decimal
  finalAmount decimal
  finalCTC decimal
  startDate date
  endDate date
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table allowances {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  componentId uuid [ref: > master_components.id]
  name varchar
  type varchar
  dependent uuid
  amount decimal
  typeValue decimal
  finalAmount decimal
  startDate date
  endDate date
  endPeriodType varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table deductions {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  componentId uuid [ref: > master_components.id]
  name varchar
  type varchar
  dependent uuid
  amount decimal
  typeValue decimal
  finalAmount decimal
  startDate date
  endDate date
  endPeriodType varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table bills {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  bill_id integer [unique, note: 'auto-increment sequence']
  year integer
  month integer
  bill_date date
  net_amount float
  full_days varchar
  absent_days varchar
  leave_taken varchar
  allowed_leave varchar
  half_day varchar
  late_attendance varchar
  hours_worked varchar
  bill_desc text
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table bill_infos {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  bill_id integer
  year integer
  month integer
  bill_date date
  pay_component_id uuid [ref: > master_components.id]
  pay_code varchar
  amount varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table salary_docs {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  year integer
  month integer
  chequeNo varchar
  bill_date date
  net_amount float
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table salary_orders {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  component varchar
  order integer
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table currencies {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  name varchar
  status varchar [default: 'active']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

// ─────────────────────────────────────────────
// FIELD TRACKING
// ─────────────────────────────────────────────

Table tracking_sessions {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  attendanceId uuid [ref: > attendances.id]
  startedAt timestamp
  endedAt timestamp
  startLatitude double
  startLongitude double
  endLatitude double
  endLongitude double
  totalDistanceKm decimal
  totalDurationMin integer
  trackingMode varchar [default: 'field', note: 'field | attendance | recruitment | manual']
  status varchar [default: 'active', note: 'active | paused | completed | cancelled']
  deviceId varchar
  batteryStart integer
  batteryEnd integer
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table tracking_points {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  sessionId uuid [ref: > tracking_sessions.id]
  employeeId uuid [ref: > emp_personals.id]
  latitude double
  longitude double
  altitude double
  accuracy double
  speed double
  heading double
  address text
  capturedAt timestamp
  source varchar [default: 'mobile', note: 'mobile | web | device']
  networkMode varchar
  batteryLevel integer
  isMockLocation boolean [default: false]
  createdAt timestamp
  updatedAt timestamp
}

Table tracking_task_updates {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  sessionId uuid [ref: > tracking_sessions.id]
  employeeId uuid [ref: > emp_personals.id]
  applicationId uuid [note: 'cross-ref to recruitment.applications']
  title varchar
  updateType varchar [note: 'visit | call | interview | follow_up | note']
  description text
  visitPlace varchar
  latitude double
  longitude double
  status varchar [default: 'open', note: 'open | in_progress | completed | cancelled']
  capturedAt timestamp
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

// ─────────────────────────────────────────────
// REIMBURSEMENTS
// ─────────────────────────────────────────────

Table reimbursements {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  employeeId uuid [ref: > emp_personals.id]
  fromDate date
  toDate date
  amount integer
  remark text
  status varchar [default: 'pending']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

Table reimbursement_files {
  id uuid [pk]
  tenantId uuid [ref: > tenants.id]
  branchId uuid [ref: > branches.id]
  reimbursementId uuid [ref: > reimbursements.id]
  image varchar
  doc_type varchar
  status varchar [default: 'pending']
  createdBy uuid
  updatedBy uuid
  createdAt timestamp
  updatedAt timestamp
}

// ─────────────────────────────────────────────
// TABLE GROUPS
// ─────────────────────────────────────────────

TableGroup shared_infrastructure {
  tenants
  branches
}

TableGroup org_structure {
  departments
  designations
  employment_types
  shifts
  prefixes
}

TableGroup employee_profile {
  emp_personals
  work_experiences
  document_types
  documents
  bank_accounts
  letter_datas
}

TableGroup attendance_tracking {
  attendances
  attendance_settings
  attendance_regularizations
  comp_offs
  device_location_logs
}

TableGroup leave_management {
  leave_masters
  leave_applications
  leave_balances
  holidays
  holiday_types
}

TableGroup payroll {
  master_components
  basics
  allowances
  deductions
  bills
  bill_infos
  salary_docs
  salary_orders
  currencies
}

TableGroup field_tracking {
  tracking_sessions
  tracking_points
  tracking_task_updates
}

TableGroup reimbursement {
  reimbursements
  reimbursement_files
}
